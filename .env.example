# Server-only provider and verification credentials
REPLICATE_API_TOKEN=
FAL_KEY=
TURNSTILE_SECRET_KEY=

# Public Turnstile site key used by the browser widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared Upstash Redis REST store. Free reservations fail closed when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC key for trusted IP buckets and anonymous owner cookies
IP_HASH_SECRET=

# Development only. Never set this in production.
DEV_ALLOW_LOCAL_REQUESTS=false

# v4: watermark off by default
WATERMARK_ENABLED=false

# Waffo is the sole payment channel. API key and public key are required by
# the official SDK in addition to the merchant id and private key.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_API_KEY=
WAFFO_PUBLIC_KEY=
# prod | sandbox (the SDK normalizes these to PRODUCTION/SANDBOX)
WAFFO_ENVIRONMENT=prod
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=

# Enable only after prices, credentials and database migration are ready.
PAID_CHECKOUT_ENABLED=false
NEXT_PUBLIC_APP_URL=https://www.ovanto.ai

# Production PostgreSQL requires sslmode=verify-full and a trusted certificate.
DATABASE_URL=
# Independent random secret, at least 32 characters.
ACCOUNT_TOKEN_SECRET=

# optional recovery email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
